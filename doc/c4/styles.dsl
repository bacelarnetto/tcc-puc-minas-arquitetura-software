// Estilos visuais, compartilhados por todas as views.
// Editar aqui apenas aparência (cor/forma) — nunca estrutura do modelo.

styles {
    element "Person" {
        shape person
        background #08427b
        color #ffffff
    }
    element "Software System" {
        background #1168bd
        color #ffffff
    }
    element "Existing System" {
        background #999999
        color #ffffff
    }
    element "Container" {
        background #438dd5
        color #ffffff
    }
    element "Database" {
        shape cylinder
    }
    element "Queue" {
        shape pipe
    }
}
